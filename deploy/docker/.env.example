# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env  &&  nano .env
# (KHÔNG commit file .env chứa mật khẩu thật lên git.)

# Image trên GHCR — đổi OWNER cho đúng tài khoản/repo GitHub (chữ thường).
IMAGE=ghcr.io/phamthuyngan31122001-tech/website_buu:latest

# Tài khoản admin khởi tạo lần đầu (đổi mật khẩu mạnh, đổi lại trong web sau khi đăng nhập).
APP_BOOTSTRAP_USERNAME=Admin@1999
APP_BOOTSTRAP_PASSWORD=DOI_MAT_KHAU_MANH

# Khóa thao tác cây tổ chức (tùy chọn). Để trống thì app tự sinh và ghi vào /data.
APP_TREE_KEY=
